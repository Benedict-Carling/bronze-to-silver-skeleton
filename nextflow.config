includeConfig 'amrproj-data-management/nextflow.config'

manifest {
    name            = 'bronze-to-silver-skeleton'
    description     = 'Minimal skeleton pipeline to process bronze data to silver'
}

params {
    bronze_tag = 'role=bronze-test'
    grades = [
        silver: [tag: 'role=bronze-test', container: 'silver', prefix: '']
    ]
}
