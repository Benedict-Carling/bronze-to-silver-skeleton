<https://github.com/ImperialCollegeLondon/bronze-to-silver-skeleton/tree/main/profiles/minimal-silver>
    a prof:Profile ;
    rdfs:label "Minimal Silver dataset" ;
    rdfs:comment """A Silver-layer dataset minimally processed from bronze."""@en ;
